# Copie para .env antes de rodar o docker compose.

# --- Banco ----------------------------------------------------------------
DB_NAME=prova_online
DB_USER=prova
DB_PASSWORD=prova
MYSQL_ROOT_PASSWORD=root

# Em produção (Hostinger) preencha com os dados do banco criado no hPanel:
# DB_HOST=localhost
# DB_PORT=3306

# --- Aplicação ------------------------------------------------------------
# Assina o cookie de sessão do professor. TROQUE por um valor longo e aleatório.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=troque-este-segredo-em-producao

# --- Rodar scripts fora do Docker (opcional) -------------------------------
# Dentro do contêiner o compose já define DB_HOST=db. Estas duas linhas só
# valem para rodar "npm run migrar" direto na sua máquina, contra o MySQL
# do Docker, que fica exposto na porta 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
